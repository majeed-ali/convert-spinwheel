// Prisma Schema optimized for PostgreSQL / MySQL in Production with Strategic High-Performance Indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop, isOnline])
}

model Shop {
  id                          String          @id @default(uuid())
  shopifyDomain               String          @unique
  accessToken                 String?
  currentPlan                 String          @default("FREE") // FREE, BASIC, GROW, ADVANCED
  monthlyImpressionsCount     Int             @default(0)
  billingCycleStartDate       DateTime        @default(now())
  usageSubscriptionLineItemId String?
  klaviyoApiKey               String?
  mailchimpApiKey             String?
  sendgridApiKey              String?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  campaigns                   Campaign[]
  leads                       Lead[]
  impressionLogs              ImpressionLog[]

  @@index([shopifyDomain])
}

model Campaign {
  id            String         @id @default(uuid())
  shopId        String
  name          String
  type          String         @default("POPUP") // POPUP, EMBED, SLIDE_IN
  status        String         @default("ACTIVE") // ACTIVE, DRAFT
  isABTest      Boolean        @default(false)
  triggers      String         @default("{}") // JSON string
  themeSettings String         @default("{}") // JSON string
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  segments      WheelSegment[]
  leads         Lead[]
  impressionLogs ImpressionLog[]

  @@index([shopId, status])
}

model WheelSegment {
  id             String   @id @default(uuid())
  campaignId     String
  label          String
  discountType   String   @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING, TRY_AGAIN
  discountValue  String   @default("10")
  customCode     String?  @default("")
  winProbability Float    @default(10.0)
  hexColor       String   @default("#3B82F6")
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, position])
}

model Lead {
  id               String   @id @default(uuid())
  shopId           String
  campaignId       String?
  email            String?
  phone            String?
  wonCode          String?
  wonDiscountLabel String?
  ipAddress        String?
  deviceType       String?  @default("desktop")
  sessionHash      String?
  convertedAt      DateTime @default(now())

  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([shopId, email])
  @@index([shopId, phone])
  @@index([shopId, ipAddress, convertedAt])
}

model ImpressionLog {
  id          String   @id @default(uuid())
  shopId      String
  campaignId  String?
  sessionHash String?
  timestamp   DateTime @default(now())

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([shopId, timestamp])
  @@index([timestamp])
}
